{
    "name": "@pulsanova/eslint-config-browser",
    "version": "3.3.4",
    "license": "MIT",
    "type": "module",
    "main": "./index.js",
    "exports": {
        ".": "./index.js",
        "./esnext": "./esnext.js"
    },
    "repository": {
        "type": "git",
        "url": "ssh://git@github.com:Pulsanova/Eslint.git",
        "directory": "packages/browser"
    },
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "scripts": {
        "find-new-rules": "eslint-find-rules --unused --no-error --deprecated --flatConfig ./index.js --ext .js .ts .cjs .mjs .cts .mts",
        "inspect-config": "eslint --inspect-config --config ./index.js"
    },
    "dependencies": {
        "@pulsanova/eslint-config-base": "3.3.4",
        "@typescript-eslint/parser": "~8.62.0",
        "confusing-browser-globals": "~1.0.11",
        "eslint-import-resolver-typescript": "~4.4.5",
        "eslint-plugin-import-x": "~4.17.1",
        "globals": "^17.7.0"
    },
    "devDependencies": {
        "eslint": "^10.6.0",
        "eslint-find-rules": "^5.0.0"
    },
    "peerDependencies": {
        "eslint": "^10.6.0"
    }
}
