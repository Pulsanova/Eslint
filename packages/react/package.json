{
    "name": "@pulsanova/eslint-config-react",
    "version": "3.3.3",
    "license": "MIT",
    "type": "module",
    "main": "./index.js",
    "exports": "./index.js",
    "repository": {
        "type": "git",
        "url": "ssh://git@github.com:Pulsanova/Eslint.git",
        "directory": "packages/react"
    },
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "scripts": {
        "find-new-rules": "eslint-find-rules --unused --no-error --deprecated --flatConfig ./index.js --ext .js .ts .cjs .mjs .cts .mts .jsx .tsx",
        "inspect-config": "eslint --inspect-config --config ./index.js"
    },
    "dependencies": {
        "@eslint-react/eslint-plugin": "~5.10.0",
        "@pulsanova/eslint-config-browser": "3.3.3",
        "@tanstack/eslint-plugin-query": "~5.101.2",
        "eslint-import-resolver-typescript": "~4.4.5",
        "eslint-plugin-class-methods-use-this-regex": "~2.0.1",
        "eslint-plugin-import-x": "~4.17.1",
        "eslint-plugin-jsx-a11y-x": "~0.2.0",
        "eslint-plugin-react-hooks-configurable": "~7.1.1"
    },
    "devDependencies": {
        "eslint": "^10.6.0",
        "eslint-find-rules": "^5.0.0",
        "react": "^17 || ^18 || ^19",
        "react-dom": "^17 || ^18 || ^19"
    },
    "peerDependencies": {
        "eslint": "^10.6.0",
        "react": "*",
        "react-dom": "*"
    }
}
