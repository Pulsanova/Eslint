{
    "name": "@pulsanova/eslint-config-esnext",
    "version": "3.2.0",
    "license": "MIT",
    "type": "module",
    "main": "./index.js",
    "exports": "./index.js",
    "repository": {
        "type": "git",
        "url": "ssh://git@github.com:Pulsanova/Eslint.git",
        "directory": "packages/esnext"
    },
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "scripts": {
        "find-new-rules": "eslint-find-rules --unused --no-error --deprecated --flatConfig ./index.js --ext .js .ts .cjs .mjs .cts .mts",
        "inspect-config": "eslint --inspect-config --config ./index.js"
    },
    "dependencies": {
        "@babel/core": "^8",
        "@babel/eslint-parser": "~8.0.1",
        "@babel/eslint-plugin": "~8.0.1",
        "@pulsanova/eslint-config-base": "3.2.0",
        "@typescript-eslint/parser": "~8.62.0",
        "eslint-import-resolver-typescript": "~4.4.5",
        "eslint-plugin-import-x": "~4.17.1"
    },
    "devDependencies": {
        "eslint": "^10.6.0",
        "eslint-find-rules": "^5.0.0",
        "typescript": "^6.0.3"
    },
    "peerDependencies": {
        "eslint": "^10.6.0"
    }
}
