{
    "name": "@pulsanova/eslint-config-vue",
    "version": "3.3.3",
    "license": "MIT",
    "type": "module",
    "main": "./index.js",
    "exports": "./index.js",
    "repository": {
        "type": "git",
        "url": "ssh://git@github.com:Pulsanova/Eslint.git",
        "directory": "packages/vue"
    },
    "keywords": [
        "eslint",
        "eslintconfig"
    ],
    "scripts": {
        "find-new-rules": "eslint-find-rules --unused --no-error --deprecated --flatConfig ./index.js --ext .js .ts .cjs .mjs .cts .mts .jsx .tsx",
        "inspect-config": "eslint --inspect-config --config ./index.js"
    },
    "dependencies": {
        "@pulsanova/eslint-config-browser": "3.3.3",
        "@typescript-eslint/parser": "~8.62.0",
        "eslint-import-resolver-typescript": "~4.4.5",
        "eslint-plugin-import-x": "~4.17.1",
        "eslint-plugin-vue": "~10.9.2",
        "vue-eslint-parser": "~10.4.1"
    },
    "devDependencies": {
        "eslint": "^10.6.0",
        "eslint-find-rules": "^5.0.0"
    },
    "peerDependencies": {
        "eslint": "^10.6.0"
    }
}
